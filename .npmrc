# Erlaubt dem Install-Skript von esbuild (Dashboard-Build) zu laufen - neuere npm-Versionen blockieren es sonst.
allow-scripts=esbuild

# Blendet Warnungen bei der Installation aus (u. a. "deprecated discord.js@14.28.0" - die Version ist bewusst fest gesetzt).
# Fehler werden weiterhin angezeigt. Zum Fehlersuchen einmalig: npm i --loglevel=warn
loglevel=error
