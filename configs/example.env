# ---------- Twitch (Chat-Login des Bot-Accounts, läuft über twurple) ----------
TWITCH_BOT_USERNAME=dein_bot_account
# OAuth-Token des Bot-Accounts (Scopes: chat:read chat:edit), z. B. über https://twitchtokengenerator.com
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Kanäle ohne #, mit Komma getrennt
TWITCH_CHANNELS=dein_kanal

# ---------- Twitch-App (Helix-API) ----------
# Eigene App auf https://dev.twitch.tv/console anlegen -> Client-ID und Client-Secret.
# OAuth Redirect URL der App: <WEB_PUBLIC_URL>/api/auth/twitch/callback
# Die Tokens (Streamer und Bot-Account) werden NICHT hier eingetragen, sondern im Dashboard unter
# "Benutzer" -> "Twitch-Autorisierung" pro Kanal autorisiert. Sie liegen dann in der Datenbank und
# werden automatisch erneuert. Die nötigen Scopes fordert der Bot beim Autorisieren selbst an.
# Der Token-Besitzer bzw. der Bot-Account muss im Kanal Moderator sein (der Broadcaster selbst reicht).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------- PostgreSQL ----------
PGHOST=localhost
PGPORT=5432
PGUSER=dbuser
PGPASSWORD=super_secret_password
PGDATABASE=dbdatabase

# ---------- Bot ----------
COMMAND_PREFIX=!
# Twitch-Namen mit Dev-Rechten (Stufe 10), Komma getrennt
TWITCH_DEVS=
# true = nur Namen aus configs/mods.txt gelten als Mods
TWITCH_PERMIT=false
# Standard-Cooldown (Sekunden) für neue Custom Commands (pro Command änderbar mit -cd=)
DEFAULT_COOLDOWN_SECONDS=5
# Alles andere (Cooldown, Raid, Automessage, Filter, Loyalty ...) wird pro Kanal im Dashboard eingestellt.

# ---------- Web-Interface ----------
WEB_ENABLED=true
WEB_PORT=3080
# Normalerweise leer lassen (das Dashboard wird vom Bot selbst ausgeliefert). Nur setzen, wenn es von einer anderen Adresse
# aus aufgerufen wird, dann genau diese Adresse eintragen. "*" erlaubt jede Webseite und wird nicht empfohlen.
WEB_CORS_ORIGIN=
# Nur wenn ein Reverse-Proxy (nginx, Caddy, Cloudflare ...) vor dem Bot steht: true (oder Anzahl der Proxys). Dann zählt die
# echte Besucher-IP für die Begrenzung der Anmeldeversuche. Ohne Proxy leer lassen.
WEB_TRUST_PROXY=
# Signiert die Login-Tokens der Dashboard-Benutzer. UNBEDINGT auf eine eigene Zufallszeichenkette setzen!
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mindestens 16 Zeichen, kein Platzhalter - sonst startet das Dashboard nicht.
WEB_JWT_SECRET=bitte-aendern
# Nur als Notfall-/Erstzugang gedacht (z. B. falls die Datenbank leer ist). Für den täglichen Gebrauch
# im Dashboard unter "Benutzer" einen eigenen Zugang anlegen. UNBEDINGT ändern!
# Mindestens 16 Zeichen, kein Platzhalter - sonst ist dieser Zugang deaktiviert. Wird außerdem für die Ersteinrichtung
# (ersten Benutzer anlegen) verlangt.
WEB_ADMIN_TOKEN=bitte-aendern
# Öffentlich erreichbare Basis-URL des Dashboards (ohne "/" am Ende), z. B. https://bot.example.com.
# Wird für die Twitch-Autorisierung als Redirect-URL gebraucht (siehe oben). Ohne Angabe wird sie aus dem
# Request abgeleitet, hinter einem Reverse-Proxy ggf. mit falschem Protokoll (http statt https).
WEB_PUBLIC_URL=https://bot.example.com

# ---------- Discord (optional) ----------
DISCORD_ENABLED=false
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optional: eigener Server (oder mehrere, Komma-getrennt) NUR für die Nutzer-Commands
# (/watchtime /top10 /link /unlink /twitchname). Leer = derselbe Server wie DISCORD_GUILD_ID.
DISCORD_PUBLIC_GUILD_ID=
# Rolle, die die Verwaltungs-Commands nutzen darf (zusätzlich zur Berechtigung "Server verwalten")
DISCORD_ADMIN_ROLE_ID=
# Twitch-Kanal für alle Discord-Funktionen (Verwaltung, /watchtime, "say" ...). Leer = erster Kanal aus TWITCH_CHANNELS.
DISCORD_TWITCH_CHANNEL=dein_kanal
# Discord-Textkanal, in den !blacklist (Twitch) die Blacklist schickt
DISCORD_BLACKLIST_CHANNEL_ID=
# "say": Nachrichten in diesem Discord-Kanal werden 1:1 in den Twitch-Chat gepostet.
# Dafür im Discord-Developer-Portal unter Bot -> Privileged Gateway Intents "MESSAGE CONTENT INTENT" aktivieren!
DISCORD_SAY_CHANNEL_ID=
# Optional: anderer Twitch-Kanal nur für die "say"-Nachrichten
DISCORD_SAY_TWITCH_CHANNEL=
# Optional: Farbe für alle Discord-Embeds (Hex, mit oder ohne "#"). Ohne Angabe: edbc5d.
DISCORD_EMBED_COLOR=

# ---------- Fehlersuche (nur bei Bedarf einschalten) ----------
# DEBUG=true
# Start-Diagnose: Zeiten der Startschritte, Netzwerk-Test zu Twitch, Web-Adresse, Moderator-Erfassung,
# belegte EventSub-WebSocket-Sessions (z. B. bei Fehler 429 "websocket transports limit exceeded").
# DIAGNOSE=true
